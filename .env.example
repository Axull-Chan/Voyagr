# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (Phase 1, optional) ---
# Not read by this app directly. Create a Web OAuth client in Google Cloud
# Console, then paste the client ID + secret into the Supabase dashboard under
# Authentication > Providers > Google. Listed here so the step isn't lost.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider (Phase 3A) ---
# Unset means the deterministic mock planner. Set to one of:
# mock | openai | anthropic | gemini | groq | openrouter | deepseek
# An unrecognised value fails loudly at startup rather than silently
# falling back to mock in production.
AI_PROVIDER=mock
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini.
# OPENAI_MODEL=
# Gemini is the provider actually live in production (see CLAUDE.md's Phase 4
# notes) — OpenAI is fully wired but blocked on the account's billing.
# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id. Unset uses the stable, generally available default (gemini-3.8-flash);
# avoid preview tags in production, which Google can change or withdraw. An id
# with unexpected characters is ignored and the default used.
# GEMINI_MODEL=gemini-3.8-flash
# Optional second model, tried once if the first times out or is unavailable
# (e.g. a 503 "high demand"). Ignored if unset, invalid or the same as GEMINI_MODEL.
# GEMINI_FALLBACK_MODEL=
# Commercial: Google's free tier may let Google use prompts to improve its
# products; a paid (billing-enabled) key does not. Update the Privacy page if
# you switch.

# --- AI usage limits (optional) ---
# Rolling 24-hour limits on the two calls that spend model quota: generating a trip
# and sending a chat message. The defaults suit the free Gemini tier (~1,500
# requests a day shared by every visitor); see src/lib/ai/usage-limits.ts for how
# they were sized. Each must be a whole number from 1 to 100000 — anything else is
# ignored and the default used, never "no limit". Not applied to the mock provider.
# The database caps them regardless (consume_ai_quota): at most 20 trips and 100
# messages per user, and 1000 / 2000 site-wide, per 24 h. Higher values are
# lowered to those; raising them needs a migration (and AI_LIMIT_CEILINGS).
# AI_LIMIT_TRIPS_PER_USER=5
# AI_LIMIT_TRIPS_GLOBAL=250
# AI_LIMIT_CHAT_PER_USER=30
# AI_LIMIT_CHAT_GLOBAL=500

# --- Site address (optional) ---
# The public origin used for canonical links, sitemap and share images. Unset
# means https://voyagr-taupe.vercel.app. Inlined at build time (redeploy to change).
# NEXT_PUBLIC_SITE_URL=https://voyagr-taupe.vercel.app

# --- Error monitoring (optional) ---
# Set to "on" ONLY for the Production environment. It makes server and browser
# errors be recorded durably in the error_events table. Leave it unset locally and
# on previews: they share the production database, so turning it on there would
# fill the real record with development noise. Errors are always written to the
# server log regardless. It is inlined at build time, so changing it needs a redeploy.
# NEXT_PUBLIC_ERROR_REPORTING=on

# =====================================================================
# Phase 3B — real-world data providers
#
# Two of the five need no key and work out of the box:
#   Open-Meteo   (weather)   https://open-meteo.com/en/docs
#   Frankfurter  (currency)  https://frankfurter.dev/
# The three below do. Each feature degrades to a clearly-labelled fallback
# when its key is absent, so the app runs without them — it just tells the
# user the data isn't live.
# =====================================================================

# --- Maps + geocoding: no key, no account, nothing to configure ---
# MapLibre GL JS (BSD) renders the map, OpenFreeMap serves the vector tiles,
# and Nominatim does the geocoding. Mapbox was the original choice but now
# requires a card on file even for its free tier, and its terms forbid storing
# geocoded coordinates without a paid plan. This stack has neither problem:
# OSM data is ODbL, so coordinates may be stored as long as OpenStreetMap is
# credited — which the UI does wherever a map or coordinate is shown.
#
# Both are community-run and have no SLA. Nominatim's usage policy caps
# callers at one request per second; the integration enforces that in code and
# caches results, so no configuration is needed here.
#
# Commercial / production overrides (all optional; unset = the free defaults):
# Geocoding — any Nominatim-compatible service (a hosted provider or your own
# server). A host gets /search added; a full search URL is used as given. The
# one-request-per-second throttle applies only to nominatim.openstreetmap.org.
# GEOCODING_BASE_URL=https://nominatim.example.com
# Sent as ?key= (what hosted Nominatim services expect).
# GEOCODING_API_KEY=
# An email or URL added to the User-Agent, as Nominatim's usage policy asks:
# "Voyagr/1.0 (AI travel planner; ops@example.com)".
# GEOCODING_CONTACT=
# Map tiles — loaded by the visitor's browser, so these are NEXT_PUBLIC_ and
# inlined at build time. A different tile provider needs its own credit line;
# the OpenStreetMap credit is always shown as well.
# NEXT_PUBLIC_MAP_STYLE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Weather: Open-Meteo (no key needed) ---
# The free API is for non-commercial use, and its data is CC BY 4.0 (the trip
# page credits it). For a commercial plan, set the key: requests then go to
# customer-api.open-meteo.com with &apikey=. OPEN_METEO_BASE_URL overrides the
# host either way (e.g. self-hosted).
# OPEN_METEO_API_KEY=
# OPEN_METEO_BASE_URL=

# --- Currency: Frankfurter (no key needed; ECB rates) ---
# Point at your own instance if you self-host it.
# FRANKFURTER_BASE_URL=

# --- OpenTripMap (real places: attractions, restaurants, museums) ---
# Free key from https://dev.opentripmap.org/product. A paid plan uses the same
# API with its own key. Data is from OpenStreetMap (ODbL) and Wikidata; the trip
# page credits both when real places are used.
OPENTRIPMAP_API_KEY=
# Optional: a mirror or proxy of the same API.
# OPENTRIPMAP_BASE_URL=

# --- Unsplash (destination imagery) — https://unsplash.com/oauth/applications ---
# Server-side only: the Access Key must stay confidential per Unsplash's API
# guidelines, so images are fetched on the server and hotlinked from the URLs
# it returns. Demo apps are limited to 50 requests/hour, production to 1000
# (production needs Unsplash's approval of the app, not a different endpoint).
UNSPLASH_ACCESS_KEY=

# --- Hotel booking: LiteAPI / Nuitee Connect (SANDBOX ONLY in this build) ---
# Free sandbox key from https://connect.nuitee.com (Developer tools > API Keys).
# Only keys starting with `sand_` are accepted; BOOKING_MODE=live is refused
# until live booking is deliberately built. In sandbox, the ACC_CREDIT_CARD
# method simulates payment: nothing is charged. Server-side only.
# LITEAPI_API_KEY=
# BOOKING_MODE=sandbox

# --- Supabase service role (server only; booking status writes) ---
# Bypasses row-level security, so it is used only for hotel_bookings writes,
# always scoped to the signed-in user's id. Never prefix it with NEXT_PUBLIC_.
# Supabase dashboard > Project Settings > API keys (secret key).
# SUPABASE_SERVICE_ROLE_KEY=
