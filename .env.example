# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (Phase 1, optional) ---
# Not read by this app directly. Create a Web OAuth client in Google Cloud
# Console, then paste the client ID + secret into the Supabase dashboard under
# Authentication > Providers > Google. Listed here so the step isn't lost.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- OpenAI (Phase 4: itinerary generation, Phase 8: packing list, Phase 9: AI assistant) ---
OPENAI_API_KEY=

# --- Google Maps (Phase 5: maps & location) ---
GOOGLE_MAPS_API_KEY=

# --- OpenWeather (Phase 6: weather) ---
OPENWEATHER_API_KEY=

# --- ExchangeRate (Phase 6: currency conversion) ---
EXCHANGERATE_API_KEY=
