# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (Phase 1, optional) ---
# Not read by this app directly. Create a Web OAuth client in Google Cloud
# Console, then paste the client ID + secret into the Supabase dashboard under
# Authentication > Providers > Google. Listed here so the step isn't lost.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider (Phase 3A) ---
# Unset means the deterministic mock planner. Set to one of:
# mock | openai | anthropic | gemini | groq | openrouter | deepseek
# An unrecognised value fails loudly at startup rather than silently
# falling back to mock in production.
AI_PROVIDER=mock
OPENAI_API_KEY=
# Gemini is the provider actually live in production (see CLAUDE.md's Phase 4
# notes) — OpenAI is fully wired but blocked on the account's billing.
# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =====================================================================
# Phase 3B — real-world data providers
#
# Two of the five need no key and work out of the box:
#   Open-Meteo   (weather)   https://open-meteo.com/en/docs
#   Frankfurter  (currency)  https://frankfurter.dev/
# The three below do. Each feature degrades to a clearly-labelled fallback
# when its key is absent, so the app runs without them — it just tells the
# user the data isn't live.
# =====================================================================

# --- Maps + geocoding: no key, no account, nothing to configure ---
# MapLibre GL JS (BSD) renders the map, OpenFreeMap serves the vector tiles,
# and Nominatim does the geocoding. Mapbox was the original choice but now
# requires a card on file even for its free tier, and its terms forbid storing
# geocoded coordinates without a paid plan. This stack has neither problem:
# OSM data is ODbL, so coordinates may be stored as long as OpenStreetMap is
# credited — which the UI does wherever a map or coordinate is shown.
#
# Both are community-run and have no SLA. Nominatim's usage policy caps
# callers at one request per second; the integration enforces that in code and
# caches results, so no configuration is needed here.

# --- OpenTripMap (real places: attractions, restaurants, museums) ---
# Free key from https://dev.opentripmap.org/product
OPENTRIPMAP_API_KEY=

# --- Unsplash (destination imagery) — https://unsplash.com/oauth/applications ---
# Server-side only: the Access Key must stay confidential per Unsplash's API
# guidelines, so images are fetched on the server and hotlinked from the URLs
# it returns. Demo apps are limited to 50 requests/hour, production to 1000.
UNSPLASH_ACCESS_KEY=
